	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {

		String template_type = request.getParameter("template_type_selector");
		int template_id = read_template_info();
		
        boolean isInsertedIntoTemplateType = insert_into_template_type(ps,con,template_type,template_id);
        
        if(isInsertedIntoTemplateType) {
		    pw.println("<script type=\"text/javascript\">"); 
		    pw.println("alert('Template type data inserted successfully');"); 
		    pw.println("location='digital_invitation.jsp';"); 
		    pw.println("</script>"); 
        }else {
		    pw.println("<script type=\"text/javascript\">"); 
		    pw.println("alert('Something went wrong, while inserting template type data');"); 
		    pw.println("location='digital_invitation.jsp';"); 
		    pw.println("</script>"); 
        }
	}

	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		doGet(request, response);
	}
	
	private boolean insert_into_template_type(PreparedStatement ps, Connection con, String template_type, int template_id) {
		boolean flag = false;
		try {
			ps = con.prepareStatement("insert into flyinginvite_template_type(type_title, template_id)values(?,?);");
			ps.setString(1, template_type);
			ps.setInt(2, template_id);
			ps.executeUpdate();
			flag = true;
			
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return flag;
	}
	
	private int read_template_info() {
		try {
			ps = con.prepareStatement("select max(template_id) as template_id from flyinginvite_template;");
			ResultSet rs = ps.executeQuery();
			if(rs.next()) {
				return rs.getInt("template_id");
			}
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return -1;
	}

}
