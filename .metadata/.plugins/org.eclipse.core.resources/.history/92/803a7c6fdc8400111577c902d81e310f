/**
 * Servlet implementation class SetTemplateTypeInfo
 */
@WebServlet("/SetTemplateTypeInfo")
public class SetTemplateTypeInfo extends HttpServlet {
	
	Connection con;
	PreparedStatement ps;
	ResultSet rs;
	private String driver = "com.mysql.cj.jdbc.Driver";
	private String url = "jdbc:mysql://88.222.214.58:3306/flyinginvite_invitation";
	private String username = "root";
