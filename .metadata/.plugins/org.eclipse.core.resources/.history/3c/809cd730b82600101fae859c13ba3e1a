function submitForm() {
	  const formData = new FormData();
	  formData.append("child_gender_option", document.getElementById("child_gender_option").value);
	  formData.append("casteprefOpt", document.getElementById("casteprefOpt").value);
	  formData.append("selectcaste", document.getElementById("selectcaste").value);
	  formData.append("starting_letter_pref", document.getElementById("starting_letter_pref").value);
	  formData.append("starting_letter_value", document.getElementById("starting_letter_value").value);

	  fetch("/FlyingInvite/NameGenerator", {
	    method: "POST",
	    body: formData
	  })
	  .then(response => {
	    if (response.ok) {
	      return response.blob(); // for file download
	    } else {
	      console.error("Server error.");
	    }
	  })
	  .then(blob => {
	    const url = window.URL.createObjectURL(blob);
	    const a = document.createElement("a");
	    a.href = url;
	    a.download = "result.pdf"; // or a dynamic name
	    a.click();
	  })
	  .catch(error => {
	    console.error("Fetch error:", error);
	  });
	}


