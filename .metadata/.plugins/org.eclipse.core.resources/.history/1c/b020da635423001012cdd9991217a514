function caste_preference(){
    var caste_preference_value = document.getElementById("castepref").value;
    if(caste_preference_value.includes("No")){
        document.getElementById("lbl_caste_list_options").style.display="none";
        document.getElementById("caste_list_options").style.display="none";
    }else{
        document.getElementById("lbl_caste_list_options").style.display="block";
        document.getElementById("caste_list_options").style.display="block";
        document.getElementById("lbl_caste_list_options").style.marginLeft="-105px";
    }
}


function start_letter_preference(){
    var start_letter_preference_value = document.getElementById("starting_letter").value;
    if(start_letter_preference_value.includes("No")){
      document.getElementById("lbl_start_letter_list_options").style.display="none";
      document.getElementById("starting_letter_value").style.display="none";
      return false
    }else{
        document.getElementById("lbl_start_letter_list_options").style.display="block";
        document.getElementById("starting_letter_value").style.display="block";
        return true;
    }
    
    return true;
}