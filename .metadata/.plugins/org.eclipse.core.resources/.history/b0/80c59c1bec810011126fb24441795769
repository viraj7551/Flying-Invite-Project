	private int read_template_info() {
		int template_id = 0;
		try {
		  ps = con.prepareStatement("select max(template_id) as template_id from flyinginvite_template");
		  rs = ps.executeQuery();
		  if(rs.next()) {
			  template_id = rs.getInt("template_id");
		  }
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return template_id;
	}
	
