package main.resources;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet("/SetCategoryInfo")
public class SetTemplateCategoryInfo extends HttpServlet {
	Connection con;
	PreparedStatement ps;
	ResultSet rs;
	private String driver = "com.mysql.cj.jdbc.Driver";
	private String url = "jdbc:mysql://88.222.214.58:3306/flyinginvite_invitation";
	private String username = "root";
	private String password = "13Viraj@6937";
	private PrintWriter pw;
	
	public void init() {
		try {
           Class.forName(driver);
		   con = DriverManager.getConnection(url, username, password);
		}
		catch(Exception e) {
			e.printStackTrace();
		}
	}
	
	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        pw = response.getWriter();
        response.setContentType("text/html");
        String template_category = request.getParameter("category_selector");
        int template_id = read_template_info();
        
        boolean isInsertedIntoTemplateCategory = insert_into_template_category_info(ps,con,template_category, template_id);
        if(isInsertedIntoTemplateCategory) {
		    pw.println("<script type=\"text/javascript\">"); 
		    pw.println("alert('Template type data inserted successfully');"); 
		    pw.println("location='digital_invitation.jsp';"); 
		    pw.println("</script>"); 
        }else {
		    pw.println("<script type=\"text/javascript\">"); 
		    pw.println("alert('Template type data inserted successfully');"); 
		    pw.println("location='digital_invitation.jsp';"); 
		    pw.println("</script>"); 
        }
	}
	
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		doGet(request, response);
	}
	
	private boolean insert_into_template_category_info(PreparedStatement ps , Connection con, String template_category, int template_id) {
		boolean flag = false;
		try {
			ps = con.prepareStatement("insert into flyinginvite_template_category(category_title, template_id) values(?,?);");
			ps.setString(1, template_category);
			ps.setInt(2, template_id);
			ps.executeUpdate();
			flag = true;
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return flag;
	}
	
	private int read_template_info() {
		try {
			ps = con.prepareStatement("select max(template_id) as template_id from flyinginvite_template;");
			ResultSet rs = ps.executeQuery();
			if(rs.next()) {
				return rs.getInt("template_id");
			}
		}
		catch(Exception e) {
			e.printStackTrace();
		}
		return -1;
	}

	public void destroy() {
		try {
			ps.close();
			con.close();
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	}
	
}
