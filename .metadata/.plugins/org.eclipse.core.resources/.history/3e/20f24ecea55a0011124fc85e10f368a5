    	    ps.setBlob(2, inputStream);
    	    ps.setBlob(3, inputStream02);
    	    ps.setInt(4, templateId);
    	    ps.executeUpdate();
    	    temp_flag = true;
    	}
    	
    	catch(Exception e) {
    		e.printStackTrace();
    	}
    	
    	return temp_flag;
    }
   
    protected void doGet(HttpServletRequest request, HttpServletResponse response)  throws ServletException, IOException {
